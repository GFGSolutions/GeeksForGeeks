// User template for C++

class Solution {
  public:
    vector<vector<int>> searchWord(vector<vector<char>> &mat, string &word) {
        int n = mat.size();
        int m = mat[0].size();
        int k = word.size();
        vector<vector<int>> ans;
        int dr[] = {-1, -1, -1, 0, 0, 1, 1, 1};
        int dc[] = {-1, 0, 1, -1, 1, -1, 0, 1};
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                if (mat[i][j] != word[0]) {
                    continue;
                }
                for (int d = 0; d < 8; d++) {
                    bool found = true;
                    for (int p = 1; p < k; p++) {
                        int nr = i + p * dr[d];
                        int nc = j + p * dc[d];
                        if (nr < 0 || nr >= n || nc < 0 || nc >= m ||
                            mat[nr][nc] != word[p]) {
                            found = false;
                            break;
                        }
                    }
                    if (found) {
                        ans.push_back({i, j});
                        break;
                    }
                }
            }
        }
        return ans;
    }
};
