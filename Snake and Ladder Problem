// User template for C++

class Solution {
  public:
    virtual int minThrows(int n, vector<int>& lad, vector<int>& sn){
      unordered_map<int, int> redirect;
      int ladn=lad.size();
      for(int i=0; i<ladn; i+=2) redirect[lad[i]]=lad[i+1]; 
      int snn=sn.size(); 
      for(int i=0; i<snn; i+=2) redirect[sn[i]]=sn[i+1];
      queue<int> q;
      int count=0;
      vector<bool> vis(n*n+1, false);
      q.push(1);
      vis[1]=true;
      while(!q.empty()){
        int sz=q.size();
        while(sz--){
          int fr=q.front(); q.pop();
          if(fr==n*n) return count;
          for(int i=1; i<=6; i++){
            int nx=i+fr;
            if(nx>(n*n)) continue;
            if(redirect.find(nx) != redirect.end()) nx=redirect[nx];
            if(!vis[nx]){
              vis[nx]=true;
              q.push(nx);
            }
          }
        }
        count++;  
      }
      return -1;
    }
};
