class Solution {
  public:
    vector<int> findCommon(Node* r1, Node* r2) {
        vector<int> res;
        stack<Node*> s1, s2;
        while (r1) {
            s1.push(r1);
            r1 = r1->left;
        }
        while (r2) {
            s2.push(r2);
            r2 = r2->left;
        }
        while (!s1.empty() && !s2.empty()) {
            Node* a = s1.top();
            Node* b = s2.top();
            if (a->data == b->data) {
                res.push_back(a->data);
                s1.pop();
                s2.pop();
                r1 = a->right;
                r2 = b->right;
                while (r1) {
                    s1.push(r1);
                    r1 = r1->left;
                }
                while (r2) {
                    s2.push(r2);
                    r2 = r2->left;
                }
            }
            else if (a->data < b->data) {
                s1.pop();
                r1 = a->right;
                while (r1) {
                    s1.push(r1);
                    r1 = r1->left;
                }
            }
            else {
                s2.pop();
                r2 = b->right;
                while (r2) {
                    s2.push(r2);
                    r2 = r2->left;
                }
            }
        }
        return res;
    }
};
