// User template for C++

class Solution {
  public:
    int maxFruits(vector<int>& arr, int m) {
        int ans = 0, n = arr.size();
        int temp = 0;
        for(int i=0; i<(n+m); i++) {
            if(i < m) {
                ans += arr[i];
                temp = ans;
            } else {
                temp += arr[i % n];
                temp -= arr[(i-m) % n];
                ans = max(ans, temp);
            }
        }
        return ans;
    }
};
