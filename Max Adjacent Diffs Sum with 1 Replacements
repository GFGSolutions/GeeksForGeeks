// User template for C++

class Solution {
  public:
    int maxDiffSum(vector<int>& arr) {
        int v1 = 0, v2 = 0;
        for(int i = arr.size()-2; i >= 0; i--){
            int x = max(v1, abs(1-arr[i+1]) + v2);
            int y = max(abs(arr[i]-1) + v1, abs(arr[i]-arr[i+1])+ v2);
            v1 = x;
            v2 = y;
        }
        return max(v1,v2);
    }
};
