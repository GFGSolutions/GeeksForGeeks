// User template for C++

class Solution {
public:
    vector<int> countVowels(string& s, vector<vector<int>>& queries) {
        int n = s.size();
        vector<int> pref(n + 1, 0);
        for (int i = 0; i < n; i++) {
            pref[i + 1] = pref[i];
            if (s[i] == 'a' || s[i] == 'e' || s[i] == 'i' || s[i] == 'o' ||
                s[i] == 'u')
                pref[i + 1]++;
        }
        vector<int> res;
        for (auto it : queries)
            res.push_back(pref[it[1] + 1] - pref[it[0]]);
        return res;
    }
};
