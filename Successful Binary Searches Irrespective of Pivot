// User template for C++

class Solution {
  public:
    int countAlwaysFound(vector<int>& arr) {
        int n = arr.size();
        if (n == 0) return 0;
        vector<int> sufMin(n);
        sufMin[n-1] = arr[n-1];
        for (int i = n-2; i >= 0; --i)
            sufMin[i] = min(arr[i], sufMin[i+1]);
        int ans = 0;
        int preMax = INT_MIN;
        for (int i = 0; i < n; ++i) {
            bool leftOk = (i == 0) || (arr[i] > preMax);
            bool rightOk = (i == n-1) || (arr[i] < sufMin[i+1]);
            if (leftOk && rightOk) ++ans;
            preMax = max(preMax, arr[i]);
        }
        return ans;
    }
};
