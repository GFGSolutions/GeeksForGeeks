// User template for C++

class Solution {
  public:
    int findPerimeter(vector<vector<int>> &mat) {
        int n=mat.size();
        int m=mat[0].size();
        int ans=0;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(mat[i][j]==1){
                    if(i!=0){
                        if(mat[i-1][j]==0)ans++;
                    }
                    else ans++;
                    if(j!=0){
                        if(mat[i][j-1]==0)ans++;
                    }
                    else ans++;
                    if(i!=n-1){
                        if(mat[i+1][j]==0)ans++;
                    }
                    else ans++;
                    if(j!=m-1){
                        if(mat[i][j+1]==0)ans++;
                    }
                    else ans++;
                }
            }
        }
        return ans;
    }
};
