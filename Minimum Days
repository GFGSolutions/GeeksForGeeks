// User template for C++

class Solution {
  public:
    int getMinimumDays(string &s, vector<int> &p) {
        int days = 0;
        int n = p.size();
        for(int i=0;i<n;i++){
            int idx = p[i];
            char r = (idx+1<n)?s[idx+1]:'$';
            char l = (idx-1>=0)?s[idx-1]:'$';
            if(r==s[idx] || l==s[idx]){
                s[idx] = '?';
                days=i+1;
            }
        }
        return days;
    }
};
