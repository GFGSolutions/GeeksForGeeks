// User template for C++

class Solution {
    public int palindromicStrings(int n, int k) {
        final long MOD = 1_000_000_007L;
        long ans = 0;
        long pref = 1;
        for (int m = 0; 2 * m <= n; m++) {
            if (m > 0) {
                pref = (pref * (k - m + 1)) % MOD;
            }
            if (m > 0) {
                ans = (ans + pref) % MOD;
            }
            if (2 * m + 1 <= n) {
                long odd = (pref * (k - m)) % MOD;
                ans = (ans + odd) % MOD;
            }
        }
        return (int) ans;
    }
}
