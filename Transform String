// User template for C++

class Solution {
  public:
    virtual int transform(string &s1, string &s2){
      if(s1.size() != s2.size()) return -1;
      unordered_map<char, int> um;
      for(char x: s1) um[x]++;
      for(char x: s2){
        um[x]--;
        if(um[x]==0) um.erase(x);
      }
      if(um.size()) return -1;
      int i=s1.size()-1, j=s2.size()-1;
      int ans=0;
      while(i>=0 && j>=0){
        if(s1[i]==s2[j]){ i--; j--; }
        else { ans++; i--; }
      }
      return ans;
    }
};
