// User template for C++

class Solution {
  public:
    int minTime(int n, int s1, int s2) {
        int low = 0;
        int high = n * min(s1, s2);
        int ans = 0;
        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (mid / s1 + mid / s2 >= n) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }
        return ans;
    }
};
